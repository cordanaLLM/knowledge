# Generated by Praetor from declared project commands; execution is unverified.
-include .config/praetor/engine.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test refresh-check

all: build

verify-all: compile-context-verify caveman-sources audit test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

build:
	@cd tools/knowledge-adapter-v2 && go build ./...
	@cd tools/knowledge-evidence && go build ./...
	@cd tools/knowledge-mcp && go build ./...
	@cd tools/knowledge-registry/source-acquisition-plan-enumerator && go build ./...
	@cd tools/knowledge-registry/source-acquisition-runner && go build ./...
	@cd tools/knowledge-registry/source-acquisition-runner-v3 && go build ./...
	@cd tools/knowledge-snapshot && go build ./...
	@cd tools/knowledge-retrieval && go build ./...
	@helm template kb-mcp apps/ai/kb-mcp > /dev/null

test: build
	@python3 tools/canonical_vectors.py check
	@cd tools/knowledge-adapter-v2 && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-evidence && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-mcp && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-registry/source-acquisition-plan-enumerator && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-registry/source-acquisition-runner && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-registry/source-acquisition-runner-v3 && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-snapshot && go test -p 4 -v -count=1 ./...
	@cd tools/knowledge-retrieval && go test -p 4 -v -count=1 -run 'Test(BM25|Dense|Current|Hybrid|Lifecycle|Paired|Situating|FineSpan|SharedCanonicalJSONConformance)' ./...
	@python3 -m pytest -q tools/knowledge-dogfood-evidence/tests/test_fail_closed.py
	@python3 -m pytest -q apps/ai/kb-mcp/files/test_mcpo_proxy.py
	@python3 tools/knowledge-registry/tests/test_canonical_json_conformance.py
	@helm lint apps/ai/kb-mcp

refresh-check:
	@python3 tools/canonical_vectors.py refresh-check
